{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/claude-session-start.sh",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)"
    ]
  }
}
