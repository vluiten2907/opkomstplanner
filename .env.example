# Kopieer naar .env en vul in vanuit Firebase Console > Projectinstellingen > Je apps (web-app).
# Deze waarden zijn niet geheim: de beveiliging zit in firestore.rules.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=jouw-project.firebaseapp.com
VITE_FB_PROJECT_ID=jouw-project
VITE_FB_STORAGE_BUCKET=jouw-project.appspot.com
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=
# Pad waarop de app draait. Live: /opkomst/ (conqueston.nl/opkomst). Lokaal mag dit leeg blijven.
# VITE_BASE=/opkomst/
