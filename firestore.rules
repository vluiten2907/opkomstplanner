rules_version = '2';
// Opkomstplanner — rollen: Beheer (totaal) → Beheer (groep) → Teamleider → Leiding.
// Plak dit in de Firebase-console: Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function myEmail() { return request.auth.token.email != null ? request.auth.token.email.lower() : ''; }
    // e-mailadres bevestigd via de link in de mail: pas dan weten we dat het adres echt van jou is
    function verified() { return signedIn() && request.auth.token.get('email_verified', false) == true; }
    // korte vrije tekst (komt in de uitnodigingsmail)
    function shortText(d, k) { return !d.keys().hasAny([k]) || (d[k] is string && d[k].size() <= 60); }
    function nowMs() { return request.time.toMillis(); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ---- rollen ----
    function rootPath() { return /databases/$(database)/documents/beheer/totaal; }
    function isRoot() { return signedIn() && exists(rootPath()) && me() in get(rootPath()).data.ids; }
    function groupPath(gid) { return /databases/$(database)/documents/groepen/$(gid); }
    function isGA(gid) { return signedIn() && gid is string && exists(groupPath(gid)) && me() in get(groupPath(gid)).data.adminIds; }
    // beheerder van een groep, of Beheer (totaal); een speltak zonder groep valt alleen onder Beheer (totaal)
    function isAdminOf(gid) { return isRoot() || isGA(gid); }
    function hasTl(d) { return d.keys().hasAny(['tlIds']); }
    // teamleider van speltak-data d: nieuwe speltakken via tlIds, oude via de rol per lid
    function tlOf(d) { return signedIn() && me() in d.memberIds && (hasTl(d) ? me() in d.tlIds : d.members[me()].role == 'teamleider'); }
    function spPath(sid) { return /databases/$(database)/documents/speltakken/$(sid); }
    function spGid(d) { return d.get('gid', null); }

    // ---- uitnodiging geldig voor mij? ----
    function invite(id) { return get(/databases/$(database)/documents/invites/$(id)).data; }
    function inviteKind(i) { return i.get('kind', i.get('role', '')); }
    function inviteOk(i, kind) {
      return verified() && inviteKind(i) == kind && i.email == myEmail() && i.usedBy == null && i.get('expiresAt', 9999999999999) > nowMs();
    }
    // in dezelfde schrijfactie (batch) als gebruikt gemarkeerd: dan kan dezelfde uitnodiging niet nog een keer
    function usedNow(id) { return getAfter(/databases/$(database)/documents/invites/$(id)).data.usedBy == me(); }

    // ---- gebruikersprofiel: alleen van jezelf ----
    match /users/{uid} {
      allow read, write: if signedIn() && uid == me();
    }

    // ---- accounts: opzoeken op e-mailadres om iemand direct toe te voegen ----
    match /accounts/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if verified() && email == myEmail()
        && request.resource.data.uid == me()
        && request.resource.data.email == myEmail()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'firstName', 'lastName', 'updatedAt']);
      allow delete: if false;
    }

    // ---- Beheer (totaal) ----
    match /beheer/{docId} {
      allow get: if docId == 'totaal' && signedIn() && (resource == null || me() in resource.data.ids);
      allow list: if false;
      // eenmalig: het hoofdaccount maakt het aan, met alleen zichzelf
      allow create: if docId == 'totaal' && signedIn()
        && request.auth.token.email == 'vluiten2907@gmail.com'
        && request.resource.data.ids == [me()]
        && request.resource.data.people.keys().hasOnly([me()]);
      allow update: if docId == 'totaal' && signedIn() && (
        // beheer totaal past de lijst aan (aanstellen, aftreden); er blijft altijd iemand over
        (me() in resource.data.ids
          && changed().hasOnly(['ids', 'people'])
          && request.resource.data.ids.size() > 0)
        // jezelf toevoegen met een uitnodiging als Beheer (totaal)
        || (!(me() in resource.data.ids)
          && changed().hasOnly(['ids', 'people'])
          && request.resource.data.people.diff(resource.data.people).affectedKeys().hasOnly([me()])
          && request.resource.data.ids.hasAll(resource.data.ids)
          && request.resource.data.ids.size() == resource.data.ids.size() + 1
          && me() in request.resource.data.ids
          && request.resource.data.people[me()].inviteId is string
          && inviteOk(invite(request.resource.data.people[me()].inviteId), 'totaal')
          && usedNow(request.resource.data.people[me()].inviteId))
      );
      allow delete: if false;
    }

    // ---- groepen (Scouting-verenigingen) ----
    match /groepen/{gid} {
      allow get: if isRoot() || (signedIn() && me() in resource.data.adminIds);
      allow list: if isRoot() || (signedIn() && me() in resource.data.adminIds);
      allow create: if isRoot()
        && request.resource.data.createdBy == me()
        && request.resource.data.adminIds is list
        && request.resource.data.admins is map;
      allow update: if signedIn() && (
        // Beheer (totaal): alles; beheerder van de groep: naam en beheerders, met minstens één beheerder
        isRoot()
        || (me() in resource.data.adminIds
          && changed().hasOnly(['name', 'admins', 'adminIds'])
          && request.resource.data.adminIds.size() > 0)
        // jezelf toevoegen met een uitnodiging als Beheer (groep) voor deze groep
        || (!(me() in resource.data.adminIds)
          && changed().hasOnly(['admins', 'adminIds'])
          && request.resource.data.admins.diff(resource.data.admins).affectedKeys().hasOnly([me()])
          && request.resource.data.adminIds.hasAll(resource.data.adminIds)
          && request.resource.data.adminIds.size() == resource.data.adminIds.size() + 1
          && me() in request.resource.data.adminIds
          && request.resource.data.admins[me()].inviteId is string
          && inviteOk(invite(request.resource.data.admins[me()].inviteId), 'groep')
          && invite(request.resource.data.admins[me()].inviteId).gid == gid
          && usedNow(request.resource.data.admins[me()].inviteId))
      );
      allow delete: if isRoot();

      // ---- namen: elke naam maar één keer per groep, zoals een gebruikersnaam ----
      match /namen/{key} {
        // vooraf controleren bij het aanmaken van een account (nog niet ingelogd)
        allow get: if true;
        allow list: if isAdminOf(gid);
        // je eigen naam: als lid van een speltak in deze groep, of met een uitnodiging voor deze groep
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'inviteId'])
          && request.resource.data.uid is string && request.resource.data.name is string
          && request.resource.data.name.size() <= 60
          && (isAdminOf(gid)
            || (request.resource.data.uid == me()
              && (inGroup()
                || (request.resource.data.get('inviteId', null) is string
                  && nameInviteOk(invite(request.resource.data.inviteId))))));
        allow update: if false;
        allow delete: if isAdminOf(gid) || (signedIn() && resource.data.uid == me());
      }

      // ---- groepsbank: opkomsten die speltakken delen met de hele groep ----
      function lidPath() { return /databases/$(database)/documents/groepen/$(gid)/leden/$(me()); }
      function lidSp() { return get(spPath(get(lidPath()).data.sid)).data; }
      // lid van een speltak in deze groep (vastgelegd in leden/{uid}, en nog steeds lid)
      function inGroup() { return signedIn() && exists(lidPath()) && me() in lidSp().memberIds && spGid(lidSp()) == gid; }
      // mag de bank van speltak-data d delen: lid met recht Banken of Opkomsten, speltak hoort bij deze groep
      function canShare(d) {
        return signedIn() && spGid(d) == gid && me() in d.memberIds
          && (tlOf(d) || d.members[me()].perms.bank == true || d.members[me()].perms.build == true);
      }

      function nameInviteOk(i) { return verified() && i.get('gid', null) == gid && i.email == myEmail() && i.usedBy == null; }

      match /leden/{uid} {
        allow get: if signedIn() && uid == me();
        // opruimen bij het verwijderen van de groep
        allow list: if isAdminOf(gid);
        allow create, update: if signedIn() && uid == me()
          && request.resource.data.sid is string
          && me() in get(spPath(request.resource.data.sid)).data.memberIds
          && spGid(get(spPath(request.resource.data.sid)).data) == gid;
        allow delete: if (signedIn() && uid == me()) || isAdminOf(gid);
      }

      match /gedeeld/{id} {
        allow read: if isAdminOf(gid) || inGroup();
        // eigenaar: id = {sid}_{opkomst-id}, zonder eindverantwoordelijke
        function ownerWrite() {
          return request.resource.data.sid is string && request.resource.data.oid is string
            && id == request.resource.data.sid + '_' + request.resource.data.oid
            && request.resource.data.opk.lead == ''
            && canShare(get(spPath(request.resource.data.sid)).data);
        }
        allow create: if ownerWrite() && request.resource.data.get('copies', 0) == 0;
        allow update: if (ownerWrite()
            && request.resource.data.sid == resource.data.sid
            && request.resource.data.get('copies', 0) == resource.data.get('copies', 0))
          // kopiëren telt mee: elk groepslid mag de teller met 1 ophogen
          || (inGroup() && changed().hasOnly(['copies'])
            && request.resource.data.copies == resource.data.get('copies', 0) + 1);
        allow delete: if canShare(get(spPath(resource.data.sid)).data) || isAdminOf(gid);
      }
    }

    // ---- uitnodigingen ----
    match /invites/{token} {
      // de link is het geheim: openen mag zonder account (dan kun je er een aanmaken)
      allow get: if true;
      // overzicht van openstaande uitnodigingen: per niveau
      allow list: if isRoot()
        || (resource.data.get('gid', null) is string && isGA(resource.data.gid))
        || (resource.data.get('sid', null) is string && tlOf(get(spPath(resource.data.sid)).data));
      allow create: if signedIn()
        && request.resource.data.invitedBy == me()
        && request.resource.data.usedBy == null
        && request.resource.data.email is string
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt <= nowMs() + 31 * 86400000
        && shortText(request.resource.data, 'invitedByName')
        && shortText(request.resource.data, 'groupName')
        && shortText(request.resource.data, 'speltakName')
        && (
          // Beheer (totaal) nodigt mede-beheer (totaal) uit
          (request.resource.data.kind == 'totaal' && isRoot())
          // Beheer (groep) voor een bestaande groep: door Beheer (totaal) of een beheerder van die groep
          || (request.resource.data.kind == 'groep' && request.resource.data.gid is string
              && exists(groupPath(request.resource.data.gid)) && isAdminOf(request.resource.data.gid))
          // teamleider: alleen door de beheerder van de groep
          || (request.resource.data.kind == 'teamleider' && request.resource.data.role == 'teamleider'
              && request.resource.data.sid is string
              && request.resource.data.gid == spGid(get(spPath(request.resource.data.sid)).data)
              && isAdminOf(spGid(get(spPath(request.resource.data.sid)).data)))
          // leiding: door een teamleider van die speltak of de beheerder van de groep
          // (rol overdragen = leiding met alle rechten; daarna draagt de teamleider zelf over)
          || (request.resource.data.kind == 'leiding' && request.resource.data.role == 'leiding'
              && request.resource.data.sid is string
              && request.resource.data.gid == spGid(get(spPath(request.resource.data.sid)).data)
              && (tlOf(get(spPath(request.resource.data.sid)).data) || isAdminOf(spGid(get(spPath(request.resource.data.sid)).data))))
        );
      // de genodigde markeert hem als gebruikt (met bevestigd e-mailadres, samen met het toetreden)
      allow update: if verified()
        && resource.data.usedBy == null
        && resource.data.email == myEmail()
        && changed().hasOnly(['usedBy'])
        && request.resource.data.usedBy == me();
      // intrekken: wie hem maakte, of wie erboven staat
      allow delete: if signedIn() && (
        resource.data.invitedBy == me()
        || isRoot()
        || (resource.data.get('gid', null) is string && isGA(resource.data.gid))
        || (resource.data.get('sid', null) is string && tlOf(get(spPath(resource.data.sid)).data))
      );
    }

    // ---- speltakken ----
    match /speltakken/{sid} {
      // Speltakdocument zoals het nu in de database staat
      function sp() { return get(spPath(sid)).data; }
      function spExists() { return exists(spPath(sid)); }
      function isMember() { return signedIn() && spExists() && me() in sp().memberIds; }
      function member() { return sp().members[me()]; }
      function isTL() { return isMember() && tlOf(sp()); }
      function can(p) { return isMember() && (isTL() || member().perms[p] == true); }
      function isAdmin() { return spExists() && isAdminOf(spGid(sp())); }
      function tlSame() { return request.resource.data.get('tlIds', null) == resource.data.get('tlIds', null); }
      // Team en ledenlijst lopen niet uiteen: wie in memberIds bijkomt, heeft een members-regel, en wie zijn
      // members-regel kwijtraakt, staat ook niet meer in memberIds. Alleen de wijziging telt, oude data blokkeert niet.
      function teamConsistent() {
        return request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).difference(request.resource.data.members.keys().toSet()).size() == 0
          && request.resource.data.memberIds.toSet().intersection(resource.data.members.keys().toSet().difference(request.resource.data.members.keys().toSet())).size() == 0;
      }

      allow get: if isMember() || isAdminOf(spGid(resource.data));
      // "mijn speltakken" (memberIds bevat mij), per groep (gid ==) of alles (Beheer totaal)
      allow list: if signedIn() && (me() in resource.data.memberIds || isAdminOf(spGid(resource.data)));

      // aanmaken: alleen een beheerder, binnen zijn groep, met een leeg team
      allow create: if signedIn()
        && request.resource.data.gid is string
        && isAdminOf(request.resource.data.gid)
        && request.resource.data.createdBy == me()
        && request.resource.data.memberIds == []
        && request.resource.data.tlIds == [];

      allow update: if signedIn() && (
        // instellingen en speltaknaam: teamleider of leiding met recht 'settings'. De groepsnaam alleen bij een oude
        // speltak zonder groep; onder een groep hoort hij bij de groep (kop, pdf, uitnodigingen) en past de beheerder hem aan.
        (can('settings') && (changed().hasOnly(['settings', 'name'])
          || (spGid(resource.data) == null && changed().hasOnly(['settings', 'groupName', 'name']))))
        // beheerder van de groep: team, teamleiders, naam; alleen Beheer (totaal) verhuist een speltak naar een andere groep
        || (isAdmin()
            && changed().hasOnly(['members', 'memberIds', 'tlIds', 'name', 'groupName', 'gid'])
            && teamConsistent()
            && (request.resource.data.get('gid', null) == resource.data.get('gid', null) || isRoot()))
        // teamleider: team en rechten; teamleiders erbij aanstellen niet, wel overdragen of aftreden.
        // Teamleiders blijven in het team (een mede-teamleider eruit halen doet de beheerder).
        || (isTL()
            && changed().hasOnly(['members', 'memberIds', 'tlIds'])
            && teamConsistent()
            && (!hasTl(resource.data)
                || tlSame()
                || (!(me() in request.resource.data.tlIds)
                    && request.resource.data.tlIds.size() >= 1
                    && request.resource.data.tlIds.size() <= resource.data.tlIds.size()
                    && request.resource.data.tlIds.hasAll(resource.data.tlIds.removeAll([me()]))
                    && request.resource.data.memberIds.hasAll(request.resource.data.tlIds)))
            && (!hasTl(request.resource.data) || request.resource.data.memberIds.hasAll(request.resource.data.tlIds)))
        // jezelf toevoegen met een geldige uitnodiging voor jouw e-mailadres
        || (!isMember()
            && changed().hasOnly(['members', 'memberIds', 'tlIds'])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([me()])
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && me() in request.resource.data.memberIds
            && request.resource.data.members[me()].inviteId is string
            && joinOk(invite(request.resource.data.members[me()].inviteId)))
        // jezelf uit het team halen (niet als teamleider); de rest van het team blijft precies zoals het was
        || (isMember() && !isTL()
            && changed().hasOnly(['members', 'memberIds'])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([me()])
            && !(me() in request.resource.data.members)
            && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().difference([me()].toSet()))
      );
      // speltak helemaal weggooien: alleen de beheerder van de groep (of Beheer totaal)
      allow delete: if isAdminOf(spGid(resource.data));

      function joinOk(i) {
        return i.sid == sid
          && (inviteOk(i, 'teamleider') || inviteOk(i, 'leiding'))
          && usedNow(request.resource.data.members[me()].inviteId)
          && request.resource.data.members[me()].role == inviteKind(i)
          && request.resource.data.members[me()].perms == i.perms
          && (inviteKind(i) == 'teamleider' && hasTl(resource.data)
              // teamleider erbij in tlIds
              ? (request.resource.data.tlIds.hasAll(resource.data.tlIds)
                 && request.resource.data.tlIds.size() == resource.data.tlIds.size() + 1
                 && me() in request.resource.data.tlIds)
              // leiding, of een oude speltak zonder tlIds: tlIds blijft zoals hij is
              : tlSame());
      }

      // ---- gegevens van de speltak: lezen mag elk lid en de beheerder ----
      function oldState() { return resource.data.get('state', ''); }
      function newState() { return request.resource.data.get('state', ''); }
      match /opkomsten/{id} {
        allow read: if isMember() || isAdmin();
        // De opkomstenbank (state 'bank') hoort bij Banken, de rest (concepten en ingeplande opkomsten) bij Opkomsten.
        // Alleen Opkomsten: niets in de bank aanmaken, bewerken of verwijderen (wel een kopie uit de bank als concept of ingepland).
        // Alleen Banken: alleen de opkomstenbank (ook een concept in de bank zetten), niets wat ingepland is.
        // Banken + Jaarplanning: ook koppelen en inplannen (dat schrijft de opkomst mee).
        // Nieuw aanmaken zonder Opkomsten: alleen in de bank, of een kopie uit de bank die meteen wordt ingepland (geen concept).
        allow create: if (can('build') && newState() != 'bank')
          || (can('bank') && (newState() == 'bank' || (can('plan') && newState() == 'planned')));
        allow update: if (can('build') && oldState() != 'bank' && newState() != 'bank')
          || (can('bank') && can('plan') && oldState() != 'bank' && newState() != 'bank')
          || (can('bank') && newState() == 'bank' && oldState() != 'planned');
        allow delete: if (can('build') && oldState() != 'bank') || (can('bank') && oldState() == 'bank') || isAdmin();
      }
      match /activiteiten/{id} {
        allow read: if isMember() || isAdmin();
        // de activiteitenbank: alleen met het recht Banken
        allow write: if can('bank');
        allow delete: if isAdmin();
      }
      match /planning/{id} {
        allow read: if isMember() || isAdmin();
        allow write: if can('plan') || can('build');
        allow delete: if isAdmin();
      }
    }
  }
}
