rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function myEmail() { return request.auth.token.email != null ? request.auth.token.email.lower() : ''; }

    // ---- gebruikersprofiel: alleen van jezelf ----
    match /users/{uid} {
      allow read, write: if signedIn() && uid == me();
    }

    // ---- uitnodigingen ----
    match /invites/{token} {
      // iedereen die ingelogd is kan een uitnodiging openen (de link is het geheim)
      allow get: if signedIn();
      allow list: if false;
      // alleen een teamleider van die speltak maakt uitnodigingen aan
      allow create: if signedIn()
        && request.resource.data.invitedBy == me()
        && request.resource.data.usedBy == null
        && request.resource.data.role in ['teamleider', 'leiding']
        && request.resource.data.email is string
        && get(/databases/$(database)/documents/speltakken/$(request.resource.data.sid)).data.members[me()].role == 'teamleider';
      // de genodigde markeert hem als gebruikt; de teamleider mag hem verwijderen
      allow update: if signedIn()
        && resource.data.usedBy == null
        && resource.data.email == myEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
        && request.resource.data.usedBy == me();
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/speltakken/$(resource.data.sid)).data.members[me()].role == 'teamleider';
    }

    // ---- speltakken ----
    match /speltakken/{sid} {
      // Speltakdocument zoals het nu in de database staat
      function sp() { return get(/databases/$(database)/documents/speltakken/$(sid)).data; }
      function spExists() { return exists(/databases/$(database)/documents/speltakken/$(sid)); }
      function isMember() { return spExists() && me() in sp().memberIds; }
      function member() { return sp().members[me()]; }
      function isTL() { return isMember() && member().role == 'teamleider'; }
      function can(p) { return isMember() && (member().role == 'teamleider' || member().perms[p] == true); }

      allow get: if isMember();
      // lijst van "mijn speltakken" (query op memberIds array-contains eigen uid)
      allow list: if signedIn() && me() in resource.data.memberIds;

      // aanmaken: je bent zelf de enige teamleider
      allow create: if signedIn()
        && request.resource.data.createdBy == me()
        && request.resource.data.memberIds == [me()]
        && request.resource.data.members.keys().hasOnly([me()])
        && request.resource.data.members[me()].role == 'teamleider';

      allow update: if signedIn() && (
        // instellingen, groepsnaam en speltaknaam: teamleider of leiding met recht 'settings'
        (can('settings') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settings', 'groupName', 'name']))
        // teambeheer: teamleider past leden en rechten aan
        || (isTL() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds']))
        // jezelf toevoegen met een geldige, ongebruikte uitnodiging voor jouw e-mailadres
        || (signedIn() && !isMember()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds'])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([me()])
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.resource.data.members[me()].inviteId is string
            && get(/databases/$(database)/documents/invites/$(request.resource.data.members[me()].inviteId)).data.sid == sid
            && get(/databases/$(database)/documents/invites/$(request.resource.data.members[me()].inviteId)).data.email == myEmail()
            && get(/databases/$(database)/documents/invites/$(request.resource.data.members[me()].inviteId)).data.usedBy == null
            && request.resource.data.members[me()].role == get(/databases/$(database)/documents/invites/$(request.resource.data.members[me()].inviteId)).data.role
            && request.resource.data.members[me()].perms == get(/databases/$(database)/documents/invites/$(request.resource.data.members[me()].inviteId)).data.perms)
        // jezelf uit het team halen (niet als laatste teamleider)
        || (isMember() && member().role != 'teamleider'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds'])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([me()])
            && !(me() in request.resource.data.memberIds))
      );
      allow delete: if false;

      // ---- gegevens van de speltak ----
      match /opkomsten/{id} {
        allow read: if isMember();
        allow write: if can('build') || can('bank');
      }
      match /activiteiten/{id} {
        allow read: if isMember();
        allow write: if can('bank') || can('build');
      }
      match /planning/{id} {
        allow read: if isMember();
        allow write: if can('plan') || can('build');
      }
    }
  }
}
