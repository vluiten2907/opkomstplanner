# Alleen het mailscript is van buitenaf bereikbaar. De config en de teller nooit.
<IfModule mod_authz_core.c>
  Require all denied
  <Files "uitnodiging-mail.php">
    Require all granted
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <Files "uitnodiging-mail.php">
    Allow from all
  </Files>
</IfModule>
Options -Indexes
